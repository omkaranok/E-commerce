{
  "compilerOptions": {
    /* === File Layout === */
    "rootDir": "./ratelimiter", // only compile ratelimiter/
    "outDir": "./dist/ratelimiter", // compiled JS goes here
    /* === Module + Target === */
    "module": "commonjs",
    "target": "ES2020",
    /* === Compatibility === */
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "lib": [
      "esnext"
    ],
    /* === Outputs === */
    "sourceMap": false,
    "declaration": false,
    /* === JS + TS Support === */
    "allowJs": false, // we only compile TS, not JS
    "skipLibCheck": true,
    /* === Type Checking === */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    /* === Module Handling === */
    "isolatedModules": false
  },
  "include": [
    "ratelimiter/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}